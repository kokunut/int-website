# 외부 데이터 연동용 환경변수 예시. 실제 값은 .env.local 에 넣고 커밋하지 않는다.
# 서버 전용 값이므로 NEXT_PUBLIC_ 접두사를 붙이지 않는다.

# 노션 (#6에서 사용)
# NOTION_TOKEN=
# NOTION_DB_NOTICES=
# NOTION_DB_CONTESTS=
# NOTION_DB_PARTNERS=
# NOTION_DB_DOCS=
# NOTION_DB_FAQ=

# 구글 (#6에서 사용)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_SHEET_ID=
# GOOGLE_CALENDAR_ID=
