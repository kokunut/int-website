# 사이트 기준 URL (sitemap·robots·OG 에 사용). 공개되어도 되는 값이라 NEXT_PUBLIC_ 사용.
# 없으면 https://int-website.vercel.app
NEXT_PUBLIC_SITE_URL=https://int-website.vercel.app

# 검색 엔진 소유 확인 코드 (선택). 값이 있을 때만 meta 태그가 들어간다. 공개되어도 되는 값.
# 발급 방법: docs/brain/06-content-ops.md "검색 엔진 등록"
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# 외부 데이터 연동용 환경변수 예시. 실제 값은 .env.local(로컬) / Vercel 환경변수에 넣고 커밋하지 않는다.
# 서버 전용 값이므로 NEXT_PUBLIC_ 접두사를 붙이지 않는다. 비워 두면 해당 항목은 src/content 목 데이터를 쓴다.
# 설정 방법: docs/brain/06-content-ops.md

# 노션 통합(Integration) 토큰
# NOTION_TOKEN=
# (선택) npm run notion:setup 이 DB를 만들 부모 페이지 id 또는 주소 (--parent 로도 지정 가능)
# NOTION_PARENT_PAGE_ID=
# 공지사항 DB id
# NOTION_DB_NOTICES=
# 공모전 DB id
# NOTION_DB_CONTESTS=
# 제휴 DB id
# NOTION_DB_PARTNERS=
# 자주 묻는 질문 DB id
# NOTION_DB_FAQ=
# 자료실 DB id (회칙·회의록·계획/결산·양식을 '분류'로 구분)
# NOTION_DB_DOCS=
# 아카이브(취업 아카이브·병영 길라잡이, '분류'로 구분) DB id
# NOTION_DB_ARCHIVE=
# 메인 배너 DB id
# NOTION_DB_BANNERS=
# 메인 팝업(제휴·행사·공지) DB id
# NOTION_DB_POPUPS=
# 건의 답변 DB id
# NOTION_DB_SUGGEST=
# 사이트 설정 DB id (링크·주소·이메일·인사말·단체 사진, 정해진 항목)
# NOTION_DB_SETTINGS=
# 부서 DB id (집행부 명단의 묶음)
# NOTION_DB_UNITS=
# 집행부 명단 DB id
# NOTION_DB_COUNCIL=

# 학사일정: 구글 캘린더의 iCal 주소(공개 주소 또는 비공개 주소) .ics URL
# ACADEMIC_ICS_URL=
# 페이백 집계: 구글 시트의 '요약' 탭만 "웹에 게시"한 CSV URL
# PAYBACK_CSV_URL=

# 대여사업 현황: 물품·총수량·대여중(·갱신일) 열이 있는 탭만 "웹에 게시"한 CSV URL. 대여 장부(이름·학번)는 다른 탭에 둘 것
# RENTAL_CSV_URL=

# 콘텐츠 즉시 갱신 API(/api/revalidate) 호출용 비밀 문자열 (길고 무작위로)
# REVALIDATE_SECRET=
